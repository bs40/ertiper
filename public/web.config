<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the Ertiper flight board (installed at http://<pc>/ertiper).
  IIS serves the pages in this folder; /api/* is forwarded to the Ertiper Windows service,
  which listens only on 127.0.0.1:8095 (see installer\ErtiperService.xml; build.ps1 checks they match).
  Needs the IIS URL Rewrite and ARR (proxy enabled) add-ons.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Ertiper API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8095/api/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Pages change with each update, so browsers always check for a newer copy. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
